{
  "name": "asmgh-dev",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:control": "bun --elide-lines=0 --filter @asmgh-dev/control dev",
    "dev:ns": "bun --elide-lines=0 --filter @asmgh-dev/nameserver dev",
    "db:generate": "bun --filter @asmgh-dev/control db:generate",
    "db:migrate": "bun --filter @asmgh-dev/control db:migrate"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "lucide-solid": "^1.67.0"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
